{
  "manifest_version": 3,
  "name": "Tetris New Tab",
  "version": "1.0.0",
  "description": "An autonomous Tetris game and sleek productivity dashboard for your new tab page.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
